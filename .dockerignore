# Cache de rotas e de config do host (route:cache, config:cache): entrava na
# imagem e fazia os testes locais rodarem com as rotas e a config antigas. O
# boot do app refaz o cache dentro do container.
bootstrap/cache/*
!bootstrap/cache/.gitignore
