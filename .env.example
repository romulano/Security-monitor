# UID/GID do host: o container roda com este usuário para poder
# escrever em storage/ pelo bind mount. Ajuste com `id -u`/`id -g`.
UID=1000
GID=1000

APP_NAME="Security Monitor"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:1515
# Sem APP_TIMEZONE: o app roda em UTC (o banco grava UTC) e mostra o horário
# de Brasília nas telas, nos logs e no agendador. Veja config/app.php.
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=secmon
DB_USERNAME=secmon
DB_PASSWORD=secmon

SESSION_DRIVER=database
SESSION_LIFETIME=240
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Acima do job mais longo (RunCrawler, 3600 s). Com o padrão de 90 s e mais de
# um worker, a análise por IA (até 300 s) seria pega de novo por outro worker.
DB_QUEUE_RETRY_AFTER=3660
CACHE_STORE=database

# Local, o e-mail só vai para o log. Em produção sai pelo servidor de envio do
# stack (docker/mail: Postfix + DKIM, só pela rede interna, sem usuário e senha):
#   MAIL_MAILER=smtp
#   MAIL_HOST=mail
#   MAIL_PORT=25
# O SPF do domínio precisa do IP do servidor e o DKIM da chave que o container
# gera no primeiro boot (Admin → E-mails mostra os dois e o registro a cadastrar).
MAIL_MAILER=log
MAIL_FROM_ADDRESS="bot@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# Respostas vão para o contato (o bot@ não tem caixa).
# MAIL_REPLY_TO=contato@example.com
# Envios por minuto (a VPS aceita poucos pela porta 25) e o nome reverso (PTR) do IP.
# MAIL_PER_MINUTE=5
# MAIL_HELO=mail.example.com

# ---------------------------------------------------------------------------
# Elasticsearch — busca com sintaxe query_string (AND/OR/NOT, aspas, curingas)
# ---------------------------------------------------------------------------
ELASTICSEARCH_HOST=http://es:9200
ELASTICSEARCH_INDEX=secmon_cases
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

# ---------------------------------------------------------------------------
# Crawler (o admin grava em `settings` e tem precedência sobre estes valores)
# ---------------------------------------------------------------------------
CRAWLER_ENABLED=true
CRAWLER_USER_AGENT="SecurityMonitorBot/1.0 (+https://example.com)"
CRAWLER_TIMEOUT=25
CRAWLER_MAX_ITEMS_PER_SOURCE=25
CRAWLER_DEDUP_THRESHOLD=0.62

# ---------------------------------------------------------------------------
# Enriquecimento por IA — driver: claude | openai | openrouter | hermes | heuristic
# ---------------------------------------------------------------------------
ENRICHER_ENABLED=true
ENRICHER_DRIVER=claude

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_VERSION=2023-06-01

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# OpenRouter (https://openrouter.ai/keys): vários fornecedores com uma chave só.
# O modelo se escolhe em Admin → Configurações; este é o padrão.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Ponte hermes (~/job/hermes): o Claude Code da máquina via HTTP. O hermes
# escuta no gateway da rede deste compose; o token é o HERMES_TOKEN do hermes.conf.
HERMES_URL=http://172.31.88.1:8765
HERMES_TOKEN=
HERMES_MODEL=sonnet
HERMES_EFFORT=low

# Exploits públicos: índice do Exploit-DB baixado uma vez por dia e cruzado
# pelo CVE (referência, não notícia). EXPLOITS_EXPLAIN pede ao hermes a
# explicação de cada exploit em destaque; a página nunca mostra o código.
EXPLOITS_ENABLED=true
EXPLOITS_EXPLAIN=true

# IndexNow: o aviso na hora aos buscadores (Bing, Yandex...) de cada matéria nova.
# Sem a variável, liga só com APP_ENV=production e o APP_URL em https com domínio (em
# casa, nem sai); o admin desliga em Configurações. Não deixe a linha vazia: vazio é falso.
# INDEXNOW_ENABLED=false

# ---------------------------------------------------------------------------
# Alertas personalizados (o admin liga/desliga e ajusta limites em /admin/alertas)
# ---------------------------------------------------------------------------
ALERTS_ENABLED=true
# App do Security Monitor no Slack, para o botão "Adicionar ao Slack" (escopo incoming-webhook).
# Redirect URL do app: ${APP_URL}/alertas/slack/callback. Vazio = só webhook colado.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# App do Security Monitor no Discord (Developer Portal → Security Monitor): Application ID, Client
# Secret (OAuth2 → Redefinir segredo) e token do bot (Bot → Redefinir token).
# Redirect do app: ${APP_URL}/alertas/discord/callback.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
# Servidor do Security Monitor no Discord (o bot precisa estar nele com "Criar convite").
# Quem escolhe mensagem direta entra nele: o Discord exige um servidor em comum.
DISCORD_HOME_GUILD_ID=
# Bot do Security Monitor no Telegram (@BotFather → /mybots → API Token). Depois de
# preencher: php artisan secmon:telegram-setup (confere o token e grava o perfil).
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=SecurityMonitorDevBot
# IPs de saída do servidor (vírgula). Entram na regra de liberação que o
# cliente cria na Cloudflare; vazio = a regra confia só no User-Agent SecurityMonitorBot.
ALERTS_DISCOVERY_EGRESS_IPS=
# Monitoria de segurança: endereços do servidor do Security Monitor. Site que resolve só para eles tem posse automática;
# os atrás da Cloudflare provam por TXT (secmon-verify=<token>, mostrado na tela do site).
SECURITY_OWN_IPS=
# Endereços do próprio Security Monitor que o navegador do Radar nunca abre (IP ou faixa, vírgula): o IP público do
# servidor e a faixa IPv6 dele. Pelo IP, sem a Cloudflare, a conexão cairia na borda de todos os stacks.
# Os dois de cima entram sozinhos. Em produção: SECMON_OWN_ADDRESSES=203.0.113.10,2001:db8:66:21cf::/64
SECMON_OWN_ADDRESSES=

# Verificação em duas etapas (app autenticador), opcional por conta. TWO_FACTOR_ENABLED=false é a saída de
# emergência: a tela de configurar some (404) e o login e a reautenticação deixam de pedir o código para TODAS
# as contas, inclusive as que já ligaram a 2FA (os segredos ficam guardados e voltam a valer ao religar).
TWO_FACTOR_ENABLED=true
# O admin só usa o /admin com a 2FA ligada (sem ela, vai para a tela de configurar). Ligue depois de configurar a sua.
TWO_FACTOR_ADMIN_REQUIRED=false

# ---------------------------------------------------------------------------
# Testes de segurança (teste ativo, só com autorização): desligados por padrão.
# ---------------------------------------------------------------------------
# Sem PENTEST_ALLOWED=true a área não existe (404) e nada da stack roda; o admin não liga isto. Com ela,
# toda conta vê a entrada, e só usa a conta que o admin liberou em Admin → Usuários (a de admin, sempre).
PENTEST_ALLOWED=false
# Domínios que nunca podem ser testados, nem os subdomínios (vírgula). O example.com entra sempre.
PENTEST_FORBIDDEN_DOMAINS=example.com
# O IP de saída que o termo promete aos clientes (a VPS de saída; vírgula) e o DNS reverso dele.
PENTEST_EGRESS_IPS=
PENTEST_EGRESS_RDNS=scanner.example.com
# IPs que a stack nunca testa, além dos do Security Monitor (SECMON_OWN_ADDRESSES) e da saída (IP ou faixa, vírgula).
PENTEST_FORBIDDEN_ADDRESSES=
# A chave global começa desligada (o admin liga) e a 1ª execução de cada aceite passa pelo admin.
PENTEST_ENABLED=false
PENTEST_REQUIRE_APPROVAL=true
# Execuções por conta: uma por domínio a cada 24 h e até 4 por semana (as canceladas e as recusadas não
# contam; na semana, também não conta a que terminou sem testar o site).
PENTEST_RUNS_PER_DOMAIN_PER_DAY=1
PENTEST_RUNS_PER_WEEK=4
# O teto por site, somando todas as contas: até 2 execuções por host a cada 24 h e 6 por semana (não conta
# o que não testou o site nem o que o admin liberou para um reteste).
PENTEST_RUNS_PER_HOST_PER_DAY=2
PENTEST_RUNS_PER_HOST_PER_WEEK=6
# As portas que a saída descarta (na DigitalOcean, as de e-mail): a tarefa nelas nem sai e aparece
# como "não testada", nunca "fechada". O mesmo valor vai ao executor (SECMON_SAIDA_PORTAS_BLOQUEADAS).
PENTEST_EGRESS_BLOCKED_PORTS=25,465,587
# Pré-condições para ligar a chave, registradas pelo dono: o termo publicado em /termos (versão e
# data), a data do aviso prévio aos usuários (e quantos dias antes), e a data do parecer jurídico.
PENTEST_TERMS_PUBLISHED_VERSION=
PENTEST_TERMS_PUBLISHED_AT=
PENTEST_NOTICE_GIVEN_AT=
PENTEST_NOTICE_DAYS=30
PENTEST_LEGAL_OPINION_AT=
# Data desde a qual um e-mail em abuse@example.com chama o admin no Telegram ou no Discord (ex.: Email Worker da Cloudflare).
PENTEST_ABUSE_ALERT_AT=

# ---------------------------------------------------------------------------
# Plano empresarial (empresas com várias contas e setores)
# ---------------------------------------------------------------------------
# A chave global; cada empresa ainda precisa da própria chave (a piloto primeiro).
# Os limites padrão por empresa ficam em config/secmon.php (enterprise.limits).
ENTERPRISE_ENABLED=false

# ---------------------------------------------------------------------------
# Monitoramento do GitHub (entrevista própria em /alertas/github)
# ---------------------------------------------------------------------------
GITHUB_MONITOR_ENABLED=true
# A busca em código da API do GitHub exige token. Qualquer token serve, sem
# escopo nenhum (só lê o que é público): fine-grained "Public repositories
# (read-only)" ou um GitHub App da organização. Vazio = só a busca de repositórios.
GITHUB_SEARCH_TOKEN=
# Etapa 1 (classificação por nível) e etapa 2 (parecer de envio), pelo hermes.
GITHUB_AI_TRIAGE=true
GITHUB_AI_REVIEW=true

# ---------------------------------------------------------------------------
# Entrar com o GitHub (login e cadastro). OAuth App em
# github.com/settings/developers, com o callback
# ${APP_URL}/login/github/callback. Vazio = o botão não aparece.
# ---------------------------------------------------------------------------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Captcha da Cloudflare (Turnstile) no login, no login do admin e no cadastro.
# Com a site key ele é obrigatório (sem a secret, ninguém entra); vazias = desligado (dev).
# ---------------------------------------------------------------------------
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

VITE_APP_NAME="${APP_NAME}"
